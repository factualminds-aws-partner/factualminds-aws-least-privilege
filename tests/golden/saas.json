{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamodbBatchWriteItemc55f5a",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchWriteItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:222233334444:table/audit-log"
    },
    {
      "Sid": "DynamodbBatchGetItemdb807e",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:222233334444:table/tenants",
        "arn:aws:dynamodb:us-east-1:222233334444:table/tenants/index/*"
      ]
    },
    {
      "Sid": "EventsPutEventsb3e192",
      "Effect": "Allow",
      "Action": "events:PutEvents",
      "Resource": "arn:aws:events:us-east-1:222233334444:event-bus/saas-events"
    },
    {
      "Sid": "KmsDecrypt00e874",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:222233334444:key/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": [
            "alias/saas-tenant-data"
          ]
        }
      }
    },
    {
      "Sid": "S3ListBucket66d22b",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::saas-tenant-data",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "tenants/*"
          ]
        }
      }
    },
    {
      "Sid": "S3DeleteObject77c569",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::saas-tenant-data/tenants/*"
    },
    {
      "Sid": "SesSendEmailf1e1d2",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:us-east-1:222233334444:identity/notifications.example.com"
    },
    {
      "Sid": "SqsGetQueueAttributesdc4a74",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": "arn:aws:sqs:us-east-1:222233334444:billing-jobs"
    }
  ]
}
