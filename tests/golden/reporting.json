{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamodbListTables07f95d",
      "Effect": "Allow",
      "Action": "dynamodb:ListTables",
      "Resource": "*"
    },
    {
      "Sid": "DynamodbBatchGetItembde878",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-central-1:666677778888:table/report-runs",
        "arn:aws:dynamodb:eu-central-1:666677778888:table/report-runs/index/*"
      ]
    },
    {
      "Sid": "KmsDecrypt6a947d",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:eu-central-1:666677778888:key/aaaabbbb-cccc-dddd-eeee-ffff00001111",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "secretsmanager.eu-central-1.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "LambdaInvokeFunctionfc8270",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:eu-central-1:666677778888:function:render-pdf"
    },
    {
      "Sid": "RdsdataBatchExecuteStatementd30c10",
      "Effect": "Allow",
      "Action": [
        "rds-data:BatchExecuteStatement",
        "rds-data:ExecuteStatement"
      ],
      "Resource": "arn:aws:rds:eu-central-1:666677778888:cluster:reporting-aurora"
    },
    {
      "Sid": "S3ListBucket5cff33",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::analytics-exports",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": [
            "999900001111"
          ]
        },
        "StringLike": {
          "s3:prefix": [
            "daily/*"
          ]
        }
      }
    },
    {
      "Sid": "S3GetObject229007",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::analytics-exports/daily/*",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": [
            "999900001111"
          ]
        }
      }
    },
    {
      "Sid": "S3GetBucketLocation597b00",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::reporting-output"
    },
    {
      "Sid": "S3PutObject130ced",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::reporting-output/*"
    },
    {
      "Sid": "SecretsmanagerGetSecretValue81735e",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-central-1:666677778888:secret:staging/reporting/db-??????"
    }
  ]
}
